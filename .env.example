# ======== Database (Postgres with pgvector) ========
DB_HOST=ep-rough-lab-b5of8hi1.c-7.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=password
# use "require" for RDS / Neon / Supabase; "prefer" is fine for local Docker
DB_SSLMODE="require"

# ======== Providers (free defaults) ========
EMBED_PROVIDER=fastembed        # fastembed | gemini | bedrock | ollama
LLM_PROVIDER=gemini            # gemini | bedrock | ollama | echo

# ======== RAG Parameters ========
TOP_K=5
MIN_SIMILARITY=0.45
APP_PASSWORD=                  # optional password to protect the Streamlit UI

# ======== Gemini (free tier available) ========
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=models/text-embedding-004
GEMINI_LLM_MODEL=gemini-2.5-flash

# ======== Ollama (local) ========
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.2

# ======== AWS Bedrock ========
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_REGION=us-east-1
# BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
# BEDROCK_LLM_MODEL=us.amazon.nova-lite-v1:0

# ======== Conversation memory ========
USE_PAST_CONVERSATIONS=true      # search earlier saved Q&A as extra context
PAST_TURNS=3
