# For Streamlit Community Cloud: paste these into  App -> Settings -> Secrets
# (never commit a real secrets.toml)
DB_HOST = "your-db-host"
DB_PORT = "5432"
DB_NAME = "postgres"
DB_USER = "postgres"
DB_PASSWORD = "your-password"
DB_SSLMODE = "require"

EMBED_PROVIDER = "fastembed"
LLM_PROVIDER = "groq"
GROQ_API_KEY = "your-groq-key"

APP_PASSWORD = "choose-a-password"
